{
    "openapi": "3.0.0",
    "info": {
        "title": "Elometrics API",
        "description": "API para la gestión de entrenamientos de ajedrez.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api/v1",
            "description": "API local"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registrar un usuario y obtener un token",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Jaime Romero",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jaime@example.com",
                                        "maxLength": 255
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado. Devuelve sus datos públicos y un token de acceso.",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "data": {
                                        "id": 1,
                                        "name": "Jaime Romero",
                                        "email": "jaime@example.com"
                                    },
                                    "token": {
                                        "token_type": "Bearer",
                                        "access_token": "TOKEN_DE_ACCESO"
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos de validación incorrectos."
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión y obtener un token",
                "operationId": "67d6d0fdd54fba132e1b6f55ca254183",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jaime@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Credenciales correctas. Devuelve los datos del usuario y un token."
                    },
                    "401": {
                        "description": "Credenciales incorrectas."
                    },
                    "422": {
                        "description": "Datos de validación incorrectos."
                    }
                }
            }
        },
        "/users/me": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Obtener los datos del usuario autenticado",
                "operationId": "58eb90e2b3be3d0480871a7c39a1785f",
                "responses": {
                    "200": {
                        "description": "Datos del usuario autenticado."
                    },
                    "401": {
                        "description": "Token ausente, inválido o expirado."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión revocando el token actual",
                "operationId": "28d48c13fca984400ac8de99f54ee13a",
                "responses": {
                    "204": {
                        "description": "Token actual revocado. Respuesta sin contenido."
                    },
                    "401": {
                        "description": "Token ausente, inválido o expirado."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/workspaces": {
            "post": {
                "tags": [
                    "Workspaces"
                ],
                "summary": "Crear un nuevo workspace",
                "operationId": "f939e1b7dc818f464683b44bb4ba1a16",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "status"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Workspace 1",
                                        "maxLength": 255
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "active"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Workspace creado exitosamente.",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "data": {
                                        "id": 1,
                                        "name": "Workspace 1",
                                        "email": "active"
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos de validación incorrectos."
                    },
                    "401": {
                        "description": "No autenticado."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/workspaces/{workspace}": {
            "get": {
                "tags": [
                    "Workspaces"
                ],
                "summary": "Obtener el detalle de un workspace",
                "operationId": "bc39ae11b5640832c108d7858a1ea5ab",
                "parameters": [
                    {
                        "name": "workspace",
                        "in": "path",
                        "description": "ID del workspace",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detalle del workspace devuelto exitosamente.",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "data": {
                                        "id": 1,
                                        "title": "Camino a FM",
                                        "status": "active"
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "No tienes permisos para ver este workspace."
                    },
                    "404": {
                        "description": "Workspace no encontrado."
                    },
                    "401": {
                        "description": "No autenticado."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/up": {
            "get": {
                "tags": [
                    "Estado"
                ],
                "summary": "Comprobar que la aplicación responde",
                "operationId": "43c8db3f2b224e1366d703efbca684fd",
                "responses": {
                    "200": {
                        "description": "La aplicación está operativa."
                    }
                },
                "servers": [
                    {
                        "url": "http://127.0.0.1:8000"
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Endpoints para la gestión de usuarios y sesiones"
        },
        {
            "name": "Workspaces",
            "description": "Endpoints para la gestión de workspaces"
        },
        {
            "name": "Estado",
            "description": "Estado"
        }
    ]
}