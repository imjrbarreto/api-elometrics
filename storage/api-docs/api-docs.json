                                    "data": {
                                        "id": 1,
                                        "title": "Finales de torres",
                                        "description": "Actividad de la torre y ejercicios practicos.",
                                        "category": "endgame",
                                        "resource": "https://lichess.org/study/abcd1234"
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos de validación incorrectos."
                    },
                    "401": {
                        "description": "No autenticado."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
